                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "comparable": {
              "type": "boolean"
            }
          },
          "required": [
            "acceptance",
            "using_fallback",
            "served_snapshot_id",
            "served_fetched_at",
            "baseline_units_seen",
